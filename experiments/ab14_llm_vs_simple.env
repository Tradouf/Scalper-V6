# A/B 14j paper — llmbot vs simplebot
# Usage: set -a && source experiments/ab14_llm_vs_simple.env && set +a
# Ne PAS sourcer dans le shell du simplebot LIVE (HL2).

export AB_ROOT=/home/francois/Scalper-V6/experiments/ab14
export AB_START_EQUITY=200
export AB_SYMBOLS=BTC,ETH,SOL,XPL,HYPE,LINK,AVAX,DOGE,XRP,AAVE,UNI,NEAR

# Frais paper alignés (conservateur type taker + slip)
export AB_FEE_PCT=0.00045
export AB_SLIPPAGE_PCT=0.0003
export AB_FEE_MAKER_PCT=0.00015

export AB_LEVERAGE=3
export AB_MARGIN_PCT=0.05
export AB_MAX_OPEN=4

# ── SimpleBot paper (bras A) — state isolé, dry-run, pas d'ordres ────────────
export SIMPLEBOT_DRY_RUN=1
export SIMPLEBOT_STATE_DIR=${AB_ROOT}/simplebot_state
export SIMPLEBOT_PAPER_START_EQUITY=${AB_START_EQUITY}
export SIMPLEBOT_SYMBOLS=${AB_SYMBOLS}
export SIMPLEBOT_MAX_ACTIVE_SYMBOLS=12
export SIMPLEBOT_MARGIN_PCT=${AB_MARGIN_PCT}
export SIMPLEBOT_MARGIN_PCT_MAX=${AB_MARGIN_PCT}
export SIMPLEBOT_SIZING_DYNAMIC=0
export SIMPLEBOT_MAX_OPEN_POSITIONS=${AB_MAX_OPEN}
export SIMPLEBOT_FEE_PCT=${AB_FEE_PCT}
export SIMPLEBOT_SLIPPAGE_PCT=${AB_SLIPPAGE_PCT}
export SIMPLEBOT_FEE_MAKER_PCT=${AB_FEE_MAKER_PCT}
export SIMPLEBOT_EXEC_MAKER_FIRST=1
export SIMPLEBOT_LEVERAGE=${AB_LEVERAGE}
# A/B : sleeve 15m only — pas de momentum 4h en parallèle (polluerait le PnL)
export SIMPLEBOT_MOMENTUM=0

# ── LLMBot paper (bras B) ────────────────────────────────────────────────────
export LLMBOT_DRY_RUN=1
export LLMBOT_STATE_DIR=${AB_ROOT}/llmbot_state
export LLMBOT_PAPER_START_EQUITY=${AB_START_EQUITY}
export LLMBOT_SYMBOLS=${AB_SYMBOLS}
export LLMBOT_MARGIN_PCT=${AB_MARGIN_PCT}
export LLMBOT_MAX_OPEN=${AB_MAX_OPEN}
export LLMBOT_LEVERAGE=${AB_LEVERAGE}
export LLMBOT_FEE_PCT=${AB_FEE_PCT}
export LLMBOT_SLIPPAGE_PCT=${AB_SLIPPAGE_PCT}
export LLMBOT_MIN_QUANT_SCORE=65
export LLMBOT_MIN_LLM_CONF=0.65
export LLMBOT_MAX_LLM_PER_CYCLE=3
export LLMBOT_INTERVAL=15m
export LLMBOT_EXEC_MAKER_FIRST=1
export LOCALAI_BASE_URL=${LOCALAI_BASE_URL:-http://localhost:8080/v1}
