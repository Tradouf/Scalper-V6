# === SalleDesMarches — Variables d'environnement ===
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer le .env !

# Hyperliquid wallet
HL_PRIVATE_KEY=0xVOTRE_CLE_PRIVEE_ICI
HL_ACCOUNT_ADDRESS=0xVOTRE_ADRESSE_ICI
HL_NETWORK=mainnet

# SimpleBot — second wallet DÉDIÉ (ne jamais réutiliser le wallet V6 ci-dessus)
HL2_PRIVATE_KEY=0xCLE_PRIVEE_SIMPLEBOT_ICI
HL2_ACCOUNT_ADDRESS=0xADRESSE_SIMPLEBOT_ICI

# Whale Alert API
WHALES_API_KEY=VOTRE_CLE_ICI

# LocalAI
LOCALAI_BASE_URL=http://localhost:8080/v1

# SuperBot — troisième wallet (HL3_*)
# HL3_PRIVATE_KEY=0x...
# HL3_ACCOUNT_ADDRESS=0x...

# Rate limit global API Hyperliquid (secondes entre requêtes /info, tous processus)
# HL_RATE_LIMIT_SEC=0.4

# Dashboards (Basic Auth — obligatoire pour bind LAN / 0.0.0.0)
# SIMPLEBOT_DASHBOARD_PASSWORD=change_me
# SIMPLEBOT_DASHBOARD_USER=simplebot
# SIMPLEBOT_DASHBOARD_HOST=127.0.0.1
# SUPERBOT_DASHBOARD_PASSWORD=change_me
# SUPERBOT_DASHBOARD_USER=superbot
# SUPERBOT_DASHBOARD_HOST=127.0.0.1

# Filtres qualité assouplis (optionnel — défauts juillet 2026)
# SIMPLEBOT_QUALITY_MIN_VALID_PF=1.30
# SUPERBOT_HMM_CHOPPY_MIN_CONF=0.42
